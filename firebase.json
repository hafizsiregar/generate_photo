{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "generate-photo",
          "appId": "1:58171421682:android:b9191922140efa9efd716b",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "generate-photo",
          "appId": "1:58171421682:ios:8271edeef74f0217fd716b",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "generate-photo",
          "configurations": {
            "android": "1:58171421682:android:b9191922140efa9efd716b",
            "ios": "1:58171421682:ios:8271edeef74f0217fd716b"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": [
    {
      "bucket": "generate-photo.appspot.com",
      "rules": "storage.rules"
    }
  ],
  "functions": [
    {
      "runtime": "nodejs20",
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
